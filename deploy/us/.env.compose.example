# Docker Compose settings.
HOST_PORT=7860
SMOKE_HOST_PORT=17860
QWEN2API_TAG=dev-go

# Runtime settings.
PORT=7860
ADMIN_KEY=change-me
WORKERS=1
LOG_LEVEL=INFO

# Token refresh.
TOKEN_REFRESH_ENABLED=true
TOKEN_REFRESH_INITIAL_DELAY_SECONDS=0
TOKEN_REFRESH_CHECK_INTERVAL=300
TOKEN_REFRESH_AHEAD_SECONDS=259200
TOKEN_REFRESH_STAGGER_MS=2000
TOKEN_REFRESH_STATE_FILE=/app/data/token_refresh_state.json
TOKEN_REFRESH_BATCH_SIZE=5
TOKEN_REFRESH_BATCH_TIMEOUT_SECONDS=600
TOKEN_REFRESH_SLOW_SCAN_INTERVAL_SECONDS=1800
TOKEN_REFRESH_BREAKER_FAILURES=5
TOKEN_REFRESH_BREAKER_COOLDOWN_SECONDS=21600
PERFORMANCE_RELEASE_STAGE=A
BROWSER_DISABLE_DEV_SHM_USAGE=true

# Optional account-sticky upstream proxy pool. Keep credentials in mounted secret files.
# UPSTREAM_PROXY_TEMPLATE_FILE=/run/secrets/qwen2api/upstream_proxy_template
# UPSTREAM_PROXY_UUIDS_FILE=/run/secrets/qwen2api/upstream_proxy_uuids

# Container paths. Do not use host absolute paths inside the container.
BASE_DIR=/app
DATA_DIR=/app/data
LOGS_DIR=/app/logs
ACCOUNTS_FILE=/app/data/accounts.json
USERS_FILE=/app/data/users.json
CAPTURES_FILE=/app/data/captures.json
CONTEXT_GENERATED_DIR=/app/data/context_files
CONTEXT_CACHE_FILE=/app/data/context_cache.json
UPLOADED_FILES_FILE=/app/data/uploaded_files.json
CONTEXT_AFFINITY_FILE=/app/data/session_affinity.json
VIDEO_TASKS_FILE=/app/data/video_tasks.json

# Request/account behavior.
MAX_INFLIGHT_PER_ACCOUNT=2
GLOBAL_MAX_INFLIGHT=32
MAX_QUEUE_SIZE=64
MAX_RETRIES=3
ACCOUNT_MIN_INTERVAL_MS=0
REQUEST_JITTER_MIN_MS=0
REQUEST_JITTER_MAX_MS=0
RATE_LIMIT_BASE_COOLDOWN=600
RATE_LIMIT_MAX_COOLDOWN=3600
CHAT_ID_PREWARM_TARGET_PER_ACCOUNT=0
CHAT_ID_PREWARM_TTL_SECONDS=120
TRACE_RESPONSE_FINGERPRINTS=0
TRACE_RESPONSE_TAIL_CHARS=160

# Context attachments.
CONTEXT_INLINE_MAX_CHARS=4000
CONTEXT_FORCE_FILE_MAX_CHARS=10000
CONTEXT_ATTACHMENT_TTL_SECONDS=1800
CONTEXT_UPLOAD_PARSE_TIMEOUT_SECONDS=60
CONTEXT_ALLOWED_GENERATED_EXTS=txt,md,json,log
CONTEXT_ALLOWED_USER_EXTS=txt,md,json,log,xml,yaml,yml,csv,html,css,py,js,ts,java,c,cpp,cs,php,go,rb,sh,zsh,ps1,bat,cmd,pdf,doc,docx,ppt,pptx,xls,xlsx,png,jpg,jpeg,webp,gif,tiff,bmp,svg

# Media generation throttling.
MEDIA_MAX_CONCURRENCY=1
MEDIA_MIN_INTERVAL_MS=8000
MEDIA_MAX_RETRIES=1
IMAGE_MAX_RETRIES=1
VIDEO_MAX_RETRIES=1
VIDEO_TASK_TIMEOUT_SECONDS=2400
MEDIA_WAF_BREAKER_COOLDOWN_SECONDS=600
MEDIA_COOKIE_REFRESH_BATCH=3
